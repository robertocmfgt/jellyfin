version: "3.9"

services:
  jellyfin:
    image: lscr.io/linuxserver/jellyfin:latest
    container_name: jellyfin-1
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/Chicago
      # If you access Jellyfin via a non-default host/port or reverse proxy,
      # set this to the externally reachable base (host or host:port).
      # Example: JELLYFIN_PublishedServerUrl=192.168.0.37:27898
      - JELLYFIN_PublishedServerUrl=192.168.0.37:27898
    volumes:
      - /config:/config:rw
      - /cache:/cache:rw         # Recommended cache mount
      - /mnt/nas/output:/output:ro
      - /mnt/nas/output-1:/output-1:ro
    ports:
      - "27898:8096"            # HTTP
      - "27899:8920"            # HTTPS (optional)
      - "7359:7359/udp"         # Auto-discovery (optional; host port should be 7359)
      - "1900:1900/udp"         # DLNA/SSDP (optional; must be 1900 on host)
    restart: unless-stopped
    # Optional but useful:
    healthcheck:
      test: ["CMD", "curl", "-f", "http://ljellyfin.skynet-cyberdyne-systems.duckdns.org"]  # Jellyfin exposes /health
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 30s
